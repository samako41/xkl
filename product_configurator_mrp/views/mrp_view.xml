  <!-- Update MRP Production Action Context -->
  <record id="mrp.mrp_production_action" model="ir.actions.act_window">
    <field name="context">{'search_default_todo': True, 'default_company_id': allowed_company_ids[0], 'custom_create_variant': True}</field>
  </record>

  <!-- BOM Form View -->
  <record id="mrp_bom_form_view_config" model="ir.ui.view">
    <field name="name">mrp.bom.form.product_configurator</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_tmpl_id']" position="after">
        <field name="config_ok" readonly="True" force_save="True"/>
      </xpath>

      <xpath expr="//field[@name='product_id']" position="attributes">
        <attribute name="readonly">config_ok</attribute>
        <attribute name="force_save">True</attribute>
      </xpath>

      <xpath expr="//field[@name='bom_product_template_attribute_value_ids']" position="attributes">
        <attribute name="column_invisible">not (parent.type in ('normal', 'phantom'))</attribute>
        <attribute name="readonly">parent.config_ok</attribute>
      </xpath>

      <xpath expr="//field[@name='bom_product_template_attribute_value_ids']" position="after">
        <field name="config_set_id"
               readonly="not parent.config_ok"
               options="{'create_edit': True, 'open': True}"/>
      </xpath>
    </field>
  </record>

  <!-- BOM Line Config Set -->
  <record id="mrp_bom_line_config_set_form_view" model="ir.ui.view">
    <field name="name">mrp.bom.line.config.set.form</field>
    <field name="model">mrp.bom.line.configuration.set</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name"/>
          <field name="configuration_ids">
            <list editable="bottom">
              <field name="value_ids" widget="many2many_tags"/>
            </list>
          </field>
          <field name="bom_line_ids">
            <list>
              <field name="bom_id"/>
              <field name="product_id"/>
            </list>
          </field>
        </group>
      </form>
    </field>
  </record>

  <record id="mrp_bom_line_config_set_tree_view" model="ir.ui.view">
    <field name="name">mrp.bom.line.config.set.tree</field>
    <field name="model">mrp.bom.line.configuration.set</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
      </list>
    </field>
  </record>

  <!-- Action and Menus -->
  <record id="action_mrp_bom_line_config_set" model="ir.actions.act_window">
    <field name="name">Configuration Sets</field>
    <field name="res_model">mrp.bom.line.configuration.set</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_mrp_bom_line_config_set"
            parent="mrp.menu_mrp_bom"
            action="action_mrp_bom_line_config_set"
            sequence="20"/>

  <menuitem id="product_menu_mrp_bom_line_config_set"
            parent="product_configurator.menu_product_configurable_settings"
            name="Configuration Sets"
            action="action_mrp_bom_line_config_set"
            sequence="45"/>
</odoo>
