<odoo>
  <record id="mrp_production_form_view_config" model="ir.ui.view">
    <field name="name">mrp.production.form.product_configurator</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <!-- Add js_class -->
<!--      <xpath expr="//form" position="attributes">-->
<!--        <attribute name="js_class">product_configurator_mrp_form</attribute>-->
<!--      </xpath>-->

      <!-- Resize title header -->
      <xpath expr="//div[contains(@class, 'oe_title')]" position="attributes">
        <attribute name="class">oe_title col-lg-10 col-md-9 col-sm-9 col-xs-12 pull-left</attribute>
      </xpath>

      <!-- Insert Reconfigure button -->
      <xpath expr="//div[contains(@class, 'oe_title')]" position="after">
        <div class="col-lg-2 col-md-3 col-sm-3 col-xs-12 pull-left">
          <field name="config_ok" invisible="True"/>
          <button name="reconfigure_product"
                  type="object"
                  string="Reconfigure"
                  class="oe_highlight"
                  groups="product_configurator.group_product_configurator"
                  invisible="not (config_ok and state == 'draft')"/>
        </div>
      </xpath>

      <!-- Add Custom Values tab -->
      <xpath expr="//page[@name='finished_products']" position="after">
        <page name="custom_values" string="Custom Values">
          <field name="custom_value_ids" readonly="True" force_save="True">
            <list>
              <field name="attribute_id"/>
              <field name="cfg_session_id"/>
              <field name="attachment_ids"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

