        </tr>
        <tr t-if="o.xkl_req_otdr">
          <td class="req-label">OTDR Capability</td>
          <td t-esc="o.xkl_req_otdr"/>
        </tr>
        <tr t-if="o.xkl_req_distance">
          <td class="req-label">Link Distance</td>
          <td t-esc="o.xkl_req_distance"/>
        </tr>
        <tr t-if="o.xkl_req_extra">
          <td class="req-label">Additional Requirements</td>
          <td t-esc="o.xkl_req_extra"/>
        </tr>
