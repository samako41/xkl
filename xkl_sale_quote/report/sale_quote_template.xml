<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_xkl_sale_quote_document">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">
<t t-call="web.external_layout">

<!-- ════════════════════════════════════════════════════════════════════
     GLOBAL STYLES
     ════════════════════════════════════════════════════════════════════ -->
<style>
  /* ── Reset ── */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "DejaVu Sans", Arial, sans-serif;
    font-size: 10pt;
    color: #1e293b;
    line-height: 1.55;
  }

  /* ── Page layout ── */
  .xkl-page {
    page-break-after: always;
    padding: 0;
  }
  .xkl-page:last-child { page-break-after: avoid; }

  /* ── Page header band ── */
  .page-header {
    background-color: #1a3a6b;
    color: #ffffff;
    padding: 14px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0;
  }
  .page-header .logo-wrap { display: flex; flex-direction: column; }
  .page-header .logo-text {
    font-size: 22pt;
    font-weight: 900;
    letter-spacing: 5px;
    line-height: 1;
  }
  .page-header .logo-sub {
    font-size: 7pt;
    letter-spacing: 3px;
    opacity: 0.65;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .page-header .header-meta {
    text-align: right;
    font-size: 8pt;
    opacity: 0.85;
    line-height: 1.7;
  }
  .page-header .header-meta strong { font-size: 9pt; }

  /* ── Page body ── */
  .page-body {
    padding: 22px 28px 16px;
  }

  /* ── Page footer ── */
  .page-footer {
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 6px 28px;
    display: flex;
    justify-content: space-between;
    font-size: 7pt;
    color: #94a3b8;
    margin-top: 12px;
  }

  /* ── Section titles ── */
  .section-title {
    color: #1a3a6b;
    font-size: 12pt;
    font-weight: 700;
    border-bottom: 2px solid #1a3a6b;
    padding-bottom: 4px;
    margin-top: 18px;
    margin-bottom: 8px;
  }
  .section-title:first-child { margin-top: 0; }

  /* ── Body text ── */
  .body-text { font-size: 9.5pt; line-height: 1.65; margin-bottom: 6px; }
  .body-text p { margin-bottom: 5px; }
  .body-text strong { color: #1a3a6b; }

  /* ── Bullet lists ── */
  .bullet-list { margin: 6px 0 8px 18px; }
  .bullet-list li { font-size: 9.5pt; margin-bottom: 4px; }

  /* ── Cover page ── */
  .cover-wrap {
    text-align: center;
    padding: 60px 40px 40px;
  }
  .cover-logo-text {
    font-size: 48pt;
    font-weight: 900;
    letter-spacing: 10px;
    color: #1a3a6b;
    display: block;
    border-bottom: 5px solid #1a3a6b;
    display: inline-block;
    padding-bottom: 4px;
    margin-bottom: 30px;
  }
  .cover-title {
    font-size: 22pt;
    font-weight: 700;
    color: #1a3a6b;
    margin-bottom: 10px;
  }
  .cover-for {
    font-size: 13pt;
    color: #64748b;
    margin-bottom: 24px;
    font-style: italic;
  }
  .cover-client {
    font-size: 26pt;
    font-weight: 900;
    color: #1a3a6b;
    margin-bottom: 40px;
  }
  .cover-date {
    font-size: 10pt;
    color: #64748b;
    margin-top: 60px;
  }
  .cover-divider {
    width: 80px;
    height: 4px;
    background: #1a3a6b;
    margin: 20px auto;
  }

  /* ── Testimonials ── */
  .testimonial-grid {
    display: table;
    width: 100%;
    margin-top: 10px;
  }
  .testimonial-cell {
    display: table-cell;
    width: 50%;
    border: 1px solid #e2e8f0;
    padding: 10px 12px;
    vertical-align: top;
    font-size: 9pt;
  }
  .testimonial-cell:first-child { border-right: none; }
  .testimonial-company { font-weight: 700; color: #1a3a6b; margin-bottom: 2px; }
  .testimonial-since { font-size: 8pt; color: #64748b; margin-bottom: 6px; }
  .testimonial-quote { font-style: italic; color: #374151; }

  /* ── Requirements table ── */
  .req-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    font-size: 9.5pt;
  }
  .req-table th {
    background: #1a3a6b;
    color: #fff;
    padding: 7px 10px;
    text-align: left;
    font-size: 8.5pt;
    font-weight: 700;
  }
  .req-table td {
    padding: 7px 10px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .req-table tr:nth-child(even) td { background: #f8fafc; }
  .req-label { font-weight: 700; color: #1a3a6b; width: 38%; }

  /* ── Sales order table ── */
  .so-meta-grid {
    display: table;
    width: 100%;
    margin-bottom: 14px;
    font-size: 9pt;
  }
  .so-meta-cell { display: table-cell; width: 50%; vertical-align: top; }
  .so-meta-label { color: #64748b; font-size: 8pt; }

  .so-header-band {
    background: #1a3a6b;
    color: #fff;
    padding: 8px 12px;
    display: table;
    width: 100%;
    margin-bottom: 0;
  }
  .so-header-band .sh-cell { display: table-cell; vertical-align: top; }
  .so-header-band .sh-right { text-align: right; }
  .so-header-band .sh-title { font-size: 11pt; font-weight: 700; }
  .so-header-band .sh-sub { font-size: 7.5pt; opacity: 0.75; }

  .order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5pt;
    margin-bottom: 12px;
  }
  .order-table th {
    background: #1a3a6b;
    color: #fff;
    padding: 6px 8px;
    font-size: 7.5pt;
    font-weight: 700;
    text-align: left;
  }
  .order-table th.right, .order-table td.right { text-align: right; }
  .order-table th.center, .order-table td.center { text-align: center; }
  .order-table td {
    padding: 7px 8px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .order-table tr:nth-child(even) td { background: #f8fafc; }
  .order-table .item-no { font-weight: 700; color: #1a3a6b; }
  .order-table .item-desc { font-weight: 700; }
  .order-table .sub-item { color: #64748b; font-size: 7.5pt; margin-top: 2px; }
  .order-table .disc-val { color: #dc2626; }
  .order-table .net-val { font-weight: 700; color: #16a34a; }

  /* ── Totals block ── */
  .totals-wrap { width: 48%; margin-left: auto; }
  .totals-row {
    display: flex;
    justify-content: space-between;
    padding: 5px 10px;
    border-bottom: 1px solid #e2e8f0;
    font-size: 9pt;
  }
  .totals-row.final {
    font-size: 11pt;
    font-weight: 700;
    color: #1a3a6b;
    border-top: 2px solid #1a3a6b;
    border-bottom: none;
    padding-top: 7px;
  }
  .totals-row .disc-val { color: #dc2626; }

  /* ── Cost per 100G callout ── */
  .cost-callout {
    background: #1a3a6b;
    color: #fff;
    border-radius: 5px;
    padding: 10px 16px;
    margin-top: 14px;
    display: inline-block;
  }
  .cost-callout .cc-label {
    font-size: 7.5pt;
    color: #93c5fd;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cost-callout .cc-value { font-size: 18pt; font-weight: 900; line-height: 1.2; }

  /* ── Includes / Notes ── */
  .includes-block { font-size: 9pt; line-height: 1.7; margin-top: 12px; }
  .includes-block ul, .includes-block ol { margin-left: 16px; }
  .includes-block li { margin-bottom: 3px; }
  .includes-block p { margin-bottom: 4px; }

  /* ── Info badge ── */
  .info-badge {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 8.5pt;
    color: #1a3a6b;
    margin-top: 10px;
  }
</style>

<!-- ════════════════════════════════════════════════════════════════════
     PAGE 1 — COVER
     ════════════════════════════════════════════════════════════════════ -->
<div class="xkl-page">
  <div class="cover-wrap">
    <span class="cover-logo-text">XKL</span>
    <div class="cover-title" t-esc="o.xkl_proposal_title"/>
    <div class="cover-for">for</div>
    <div class="cover-divider"/>
    <div class="cover-client" t-esc="o.partner_id.name"/>
    <div class="cover-date">
      <t t-esc="o.xkl_proposal_date" t-options='{"widget": "date"}'/>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     PAGE 2 — INTRODUCTION · OBJECTIVES · CONCLUSION
     ════════════════════════════════════════════════════════════════════ -->
<div class="xkl-page">
  <div class="page-header">
    <div class="logo-wrap">
      <span class="logo-text">XKL</span>
      <span class="logo-sub">Network Solutions</span>
    </div>
    <div class="header-meta">
      <strong t-esc="o.partner_id.name"/> – Point to Point<br/>
      Quote No: <t t-esc="o.xkl_quote_number"/> and <t t-esc="o.xkl_proposal_date" t-options='{"widget": "date"}'/>
    </div>
  </div>

  <div class="page-body">

    <!-- Introduction -->
    <div class="section-title">Introduction</div>
    <div class="body-text" t-out="o.xkl_intro_body"/>

    <!-- Strategic Objectives -->
    <div class="section-title">Strategic Objectives</div>
    <div class="body-text" t-esc="o.xkl_objectives_intro"/>
    <ul class="bullet-list">
      <li t-if="o.xkl_objective_1" t-esc="o.xkl_objective_1"/>
      <li t-if="o.xkl_objective_2" t-esc="o.xkl_objective_2"/>
      <li t-if="o.xkl_objective_3" t-esc="o.xkl_objective_3"/>
    </ul>

    <!-- Conclusion -->
    <div class="section-title">Conclusion</div>
    <div class="body-text" t-out="o.xkl_conclusion_body"/>

  </div>

  <div class="page-footer">
    <span>XKL Contact: <t t-esc="o.xkl_xkl_contact"/></span>
    <span>CONFIDENTIAL – <t t-esc="o.name"/></span>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     PAGE 3 — XKL HISTORY &amp; RELIABILITY
     ════════════════════════════════════════════════════════════════════ -->
<div class="xkl-page">
  <div class="page-header">
    <div class="logo-wrap">
      <span class="logo-text">XKL</span>
      <span class="logo-sub">Network Solutions</span>
    </div>
    <div class="header-meta">
      <strong t-esc="o.partner_id.name"/><br/>
      Quote No: <t t-esc="o.xkl_quote_number"/>
    </div>
  </div>

  <div class="page-body">
    <div class="section-title">XKL's History of Innovation &amp; Reliability</div>

    <div class="body-text" t-out="o.xkl_history_body"/>

    <!-- Unique Customer Benefits -->
    <div class="section-title">Unique Customer Benefits</div>
    <ul class="bullet-list">
      <li><strong>Professional Services:</strong> We support your network team from initial consultation to full-scale deployment, mitigating downtime and future-proofing your investments.</li>
      <li><strong>Comprehensive Warranties:</strong> <t t-esc="o.xkl_warranty_highlight"/></li>
      <li><strong>Around-the-Clock Support:</strong> 24/7 customer support line with live representatives based in the United States.</li>
      <li><strong>Pre-deployment Testing:</strong> All products undergo extensive testing in our state-of-the-art laboratory to perfectly emulate network environments.</li>
      <li><strong>Efficient Sparing:</strong> Our compact product designs facilitate on-site storage of replacements and spares, simplifying logistics.</li>
      <li><strong>Compact Design:</strong> Small footprint (1 or 2 RU) and modular system architecture across our entire product line, enabling rack space and power efficiencies.</li>
    </ul>

    <!-- Testimonials -->
    <div class="section-title">Testimonials</div>
    <div class="testimonial-grid">
      <div class="testimonial-cell">
        <div class="testimonial-company">JPIX – Internet Exchange</div>
        <div class="testimonial-since">Customer since 2009</div>
        <div class="testimonial-quote">"I have lots of problems to solve, but the XKL equipment isn't one of them."</div>
      </div>
      <div class="testimonial-cell">
        <div class="testimonial-company">Smithsonian – Education &amp; Gov.</div>
        <div class="testimonial-since">Customer since 2017</div>
        <div class="testimonial-quote">"Trouble tickets went down 60% after the XKL equipment was installed."</div>
      </div>
    </div>

  </div>

  <div class="page-footer">
    <span>XKL Contact: <t t-esc="o.xkl_xkl_contact"/></span>
    <span>CONFIDENTIAL – <t t-esc="o.name"/></span>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     PAGE 4 — CUSTOMER REQUIREMENTS
