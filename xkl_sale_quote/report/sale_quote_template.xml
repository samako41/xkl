<!-- ════════════════════════════════════════════════════════════════════
     PAGE 7 — SALES ORDER FORM
     ════════════════════════════════════════════════════════════════════ -->
<div class="xkl-page">
  <div class="page-header">
    <div class="logo-wrap">
      <span class="logo-text">XKL</span>
      <span class="logo-sub">Network Solutions</span>
    </div>
    <div class="header-meta">
      <strong t-esc="o.partner_id.name"/><br/>
      Quote No: <t t-esc="o.xkl_quote_number"/>
    </div>
  </div>

  <div class="page-body">
    <div class="section-title" style="margin-top:0">Systems</div>

    <!-- Company address + order meta -->
    <div class="so-meta-grid" style="margin-bottom:14px; font-size:8.5pt;">
      <div class="so-meta-cell">
        <strong>XKL, LLC</strong><br/>
        11601 Willows Rd NE, Suite 101<br/>
        Redmond, WA 98052<br/>
        Phone: (425) 869-9050 and Fax: (425) 861-7863
      </div>
      <div class="so-meta-cell" style="text-align:right;">
        <table style="width:100%; font-size:8.5pt; border-collapse:collapse; border:1px solid #e2e8f0;">
          <tr style="background:#1a3a6b; color:#fff;">
            <th style="padding:5px 8px; text-align:center;">Date</th>
            <th style="padding:5px 8px; text-align:center;">Project</th>
            <th style="padding:5px 8px; text-align:center;">Page</th>
          </tr>
          <tr>
            <td style="padding:5px 8px; text-align:center; border:1px solid #e2e8f0;">
              <t t-esc="o.xkl_proposal_date" t-options='{"widget": "date"}'/>
            </td>
            <td style="padding:5px 8px; text-align:center; border:1px solid #e2e8f0;">
              <t t-esc="o.xkl_proposal_title"/>
            </td>
            <td style="padding:5px 8px; text-align:center; border:1px solid #e2e8f0;">1 of 1</td>
          </tr>
        </table>
      </div>
    </div>

    <!-- Contact info -->
    <div style="margin-bottom:14px; font-size:8.5pt;">
      <strong>XKL Contact:</strong> <t t-esc="o.xkl_xkl_contact"/>
      <strong>Contact:</strong> <t t-esc="o.partner_id.name"/>
      <strong>Company:</strong> <t t-esc="o.partner_id.name"/>
    </div>

    <!-- Line items table -->
    <table class="order-table">
      <thead>
        <tr>
          <th style="width:4%">Item</th>
          <th style="width:38%">Product Description</th>
          <th class="center" style="width:6%">QTY</th>
          <th class="right" style="width:13%">Unit Price</th>
          <th class="right" style="width:14%">Extended Price<br/>Before Discount</th>
          <th class="right" style="width:12%">Discount %</th>
          <th class="right" style="width:13%">Extended Price</th>
        </tr>
      </thead>
      <tbody>
        <t t-foreach="o.order_line" t-as="line">
          <tr>
            <td class="item-no"><t t-esc="line_index + 1"/></td>
            <td>
              <span class="item-desc" t-esc="line.product_id.display_name"/>
              <t t-if="line.xkl_sub_items">
                <t t-foreach="line.xkl_sub_items.split('\n')" t-as="sub">
                  <div class="sub-item" t-if="sub.strip()">• <t t-esc="sub.strip()"/></div>
                </t>
              </t>
              <t t-if="line.name and line.name != line.product_id.display_name">
                <div class="sub-item" style="color:#374151; margin-top:3px;" t-esc="line.name"/>
              </t>
            </td>
            <td class="center" t-esc="int(line.product_uom_qty)"/>
            <td class="right">
              <t t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
            <td class="right">
              <!-- Extended before discount -->
              <t t-esc="line.price_unit * line.product_uom_qty" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
            <td class="right disc-val">
              <t t-if="line.discount">(<t t-esc="'%.1f' % line.discount"/>%)</t>
              <t t-else="">—</t>
            </td>
            <td class="right net-val">
              <t t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
          </tr>
        </t>
      </tbody>
    </table>

    <!-- Totals -->
    <div style="display:table; width:100%; margin-bottom:10px;">
      <div style="display:table-cell; width:50%; vertical-align:top;">

        <!-- Total Includes -->
        <div style="font-weight:700; font-size:9pt; color:#1a3a6b; margin-bottom:4px;">Total Includes:</div>
        <div class="includes-block" t-out="o.xkl_so_includes"/>

      </div>
      <div style="display:table-cell; width:50%; vertical-align:top; padding-left:20px;">

        <div class="totals-wrap">
          <div class="totals-row">
            <span>Sub Total</span>
            <span>
              <t t-esc="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </span>
          </div>
          <t t-if="o.amount_tax">
            <div class="totals-row">
              <span>Taxes</span>
              <span>
                <t t-esc="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
              </span>
            </div>
          </t>
          <div class="totals-row">
            <span>Discount</span>
            <span class="disc-val">
              (<t t-esc="'%.1f' % (100 * (1 - o.amount_untaxed / (sum(l.price_unit * l.product_uom_qty for l in o.order_line) or 1)))"/>%)
            </span>
          </div>
          <div class="totals-row final">
            <span>Total USD</span>
            <span>
              <t t-esc="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </span>
          </div>
        </div>

        <!-- Cost per 100G callout -->
        <t t-if="o.xkl_cost_per_100g">
          <div class="cost-callout">
            <div class="cc-label">Cost per 100G Circuit</div>
            <div class="cc-value">
              <t t-esc="o.xkl_cost_per_100g" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </div>
          </div>
        </t>

      </div>
    </div>

    <!-- Notes -->
    <div style="margin-top:14px;">
      <div style="font-weight:700; font-size:9pt; color:#1a3a6b; margin-bottom:4px;">Notes:</div>
      <div class="includes-block" t-out="o.xkl_so_notes"/>
    </div>

  </div>

  <div class="page-footer">
    <span>XKL Contact: <t t-esc="o.xkl_xkl_contact"/></span>
    <span>CONFIDENTIAL – <t t-esc="o.name"/></span>
  </div>
</div>

</t><!-- end external_layout -->
</t><!-- end foreach -->
</t><!-- end html_container -->
</template>
</odoo>
